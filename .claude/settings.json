      "Bash(git push origin HEAD:main *)",
      "Bash(git reset --hard *)",
      "Bash(gh pr edit *)",
      "Bash(gh label create *)",
      "Bash(gh label edit *)",
      "Bash(gh label delete *)",
      "Bash(gh label clone *)",
      "Bash(gh api *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(*disetujui-pemilik*)"
    ]
  }
}
