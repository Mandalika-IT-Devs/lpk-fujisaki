{
  "extraKnownMarketplaces": {
    "jalankan-tiket": {
      "source": { "source": "github", "repo": "mandalikadev/jalankan-tiket" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "tiket@jalankan-tiket": true
  },
  "permissions": {
    "allow": [
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr merge *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run rerun *)",
      "Bash(git push *)",
      "Bash(pnpm *)", "Bash(docker compose *)"
