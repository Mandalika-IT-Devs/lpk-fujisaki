# Test environment. End-to-end tests always load this file, so they never touch the development database `app`.
# On your machine it points at this project's own PostgreSQL from docker-compose.yml, database app_test.
# CI points the port at its own PostgreSQL service before loading this file. No real secrets.
DATABASE_URL=postgres://app:app@localhost:56432/app_test
# Better Auth: a fixed secret used only by tests, and the address of the e2e server (playwright.config.ts, E2E_PORT 3100).
BETTER_AUTH_SECRET=CadhLo+tAeWnmIPAaJmBSZhtLsast/filpnnzORxu7o=
BETTER_AUTH_URL=http://localhost:3100
# Email: tests never send real email. The sender writes each email as a JSON file to this outbox folder,
# which e2e tests read. Playwright empties test-results/ at the start of every run.
EMAIL_KOTAK_KELUAR=test-results/kotak-keluar
EMAIL_PENGIRIM=LPKS Fujisaki Gakuin Center <no-reply@contoh.test>
