# Copy this file to .env for local development.
# The local PostgreSQL starts with `docker compose up -d`.
DATABASE_URL=postgres://app:app@localhost:56432/app
# Better Auth: replace the secret with the output of `openssl rand -base64 32`, and set the site address.
BETTER_AUTH_SECRET=ganti-dengan-keluaran-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# First Admin, read by `pnpm admin:pertama` (password at least 8 characters).
ADMIN_PERTAMA_NAMA=
ADMIN_PERTAMA_EMAIL=
ADMIN_PERTAMA_KATA_SANDI=
