# Copy this file to .env for local development.
# The local PostgreSQL starts with `docker compose up -d`.
DATABASE_URL=postgres://app:app@localhost:56432/app
# Better Auth: replace the secret with the output of `openssl rand -base64 32`, and set the site address.
BETTER_AUTH_SECRET=ganti-dengan-keluaran-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# Email over SMTP (nodemailer). Locally, Mailpit from docker-compose.yml catches every email:
# read them at http://localhost:56026. In production, fill in the institution's SMTP server and account.
SMTP_HOST=localhost
SMTP_PORT=56025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_PENGIRIM="LPKS Fujisaki Gakuin Center <no-reply@lpkfujisaki.com>"
# EMAIL_KOTAK_KELUAR is for tests only (.env.ci): it writes emails to files in that folder instead of sending them.
# First Admin, read by `pnpm admin:pertama` (password at least 8 characters).
ADMIN_PERTAMA_NAMA=
ADMIN_PERTAMA_EMAIL=
ADMIN_PERTAMA_KATA_SANDI=
