    { "nama": "PNG lebih satu byte dari 5 MB", "input": { "jenisBerkas": "image/png", "ukuranByte": 5242881, "persetujuanOrangDiFoto": true }, "output": { "diterima": false, "alasan": ["ukuran"] } },
    { "nama": "GIF tidak didukung", "input": { "jenisBerkas": "image/gif", "ukuranByte": 100000, "persetujuanOrangDiFoto": true }, "output": { "diterima": false, "alasan": ["format"] } },
    { "nama": "WebP tanpa persetujuan", "input": { "jenisBerkas": "image/webp", "ukuranByte": 1000000, "persetujuanOrangDiFoto": false }, "output": { "diterima": false, "alasan": ["persetujuan"] } },
    { "nama": "semua syarat gagal", "input": { "jenisBerkas": "image/gif", "ukuranByte": 6000000, "persetujuanOrangDiFoto": false }, "output": { "diterima": false, "alasan": ["format", "ukuran", "persetujuan"] } }
  ]
